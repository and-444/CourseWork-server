# Doxyfile 1.9.1
PROJECT_NAME           = "Network Server"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Серверная программа для клиент-серверной системы обработки данных с аутентификацией"

OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = Russian

# Генерация документации
GENERATE_HTML          = YES
GENERATE_LATEX         = YES
GENERATE_XML           = NO

# Опции для HTML
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 220
HTML_TIMESTAMP         = YES

# Опции для LaTeX
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = pdflatex

# Извлечение документации
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Исходные файлы
INPUT                  = src/
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES

# Примеры
EXAMPLE_PATH           = examples
EXAMPLE_PATTERNS       = *.cpp

# Опции разметки
ALIASES                = "russian{1}=\1"
USE_MDFILE_AS_MAINPAGE = README.md